# Supabase (the anon key is designed to be public, so EXPO_PUBLIC is fine)
EXPO_PUBLIC_SUPABASE_URL=your-url-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-key-here

# FatSecret: the app talks to our PROXY, never to FatSecret directly.
# The proxy URL is not secret.
EXPO_PUBLIC_FATSECRET_PROXY_URL=https://your-render-service.onrender.com
# Optional: only if you set PROXY_TOKEN on the proxy (see the dailynourish-proxy repo).
# Note: EXPO_PUBLIC values ship inside the app, so this is weak protection.
EXPO_PUBLIC_FATSECRET_PROXY_TOKEN=

# NOTE: the FatSecret CLIENT_ID / CLIENT_SECRET are NOT here anymore.
# They live only on the proxy (Render env vars) — never in the app bundle.

# Gemini (used by the auth/AI feature)
GEMINI_API_KEY=your-key-here
